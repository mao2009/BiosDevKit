{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_name",
          "sha256",
          "byte_length",
          "origin"
        ],
        "properties": {
          "logical_name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "origin": {
            "enum": [
              "original-project-build",
              "synthetic-fixture",
              "user-provided-reference"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
