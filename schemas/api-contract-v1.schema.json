{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mao2009/BiosDevKit/schemas/api-contract-v1.schema.json",
  "title": "BIOS API Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "apis"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "string",
      "minLength": 1
    },
    "apis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/api"
      }
    }
  },
  "$defs": {
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "entry_point",
        "inputs",
        "outputs",
        "side_effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/register"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/register"
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "platform_extension": {
          "type": "object"
        }
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "meaning"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "width_bits": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
