{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "platform",
    "result",
    "source_revision",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "SKIP"
      ]
    },
    "reason": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "FAIL",
              "BLOCKED",
              "SKIP"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\\\s]"
          }
        }
      }
    }
  ]
}
